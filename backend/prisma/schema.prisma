generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Perfil {
  ADMINISTRADOR
  ADMINISTRATIVO
  ZELADOR
}

model Unidade {
  id        String   @id @default(uuid())

  nome      String

  cep          String?
  logradouro   String?
  numero       String?
  complemento  String?
  bairro       String?

  cidade    String
  uf        String

  aluguel      Float?
  vencimento   Int?

  observacoes  String?

  locador      String?

  locadorId String?

  locadorRel Locador? @relation(fields: [locadorId], references: [id])

  kitnets   Int

  status    String @default("ATIVA")

  kitnetsRelacionadas Kitnet[]

  contratos Contrato[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Kitnet {
  id String @id @default(uuid())

  nome String?

  numero String

  metragem Float

  aluguel Float

  ocupada Boolean @default(false)

  status String @default("DISPONIVEL")

  unidadeId String

  unidade Unidade @relation(fields: [unidadeId], references: [id])

  inquilinos Inquilino[]

  contratos Contrato[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model Inquilino {

  id String @id @default(uuid())

  nome String

  email String

  telefone String

  cpf String

  rg String?

  dataNascimento DateTime?

  enderecoAnterior String?

  contatoEmergencia String?

  telefoneEmergencia String?

  dataInicioContrato DateTime

  dataFimContrato DateTime?

  prazoContrato Int?

  tipoGarantia String?

  valorCaucao Float?

  indiceReajuste String?

  ativo Boolean @default(true)

  kitnetId String

  kitnet Kitnet @relation(fields: [kitnetId], references: [id])

  contratos Contrato[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

}

model Usuario {
  id String @id @default(uuid())

  nome String

  email String @unique

  senha String

  perfil Perfil

  ativo Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model Contrato {

  id String @id @default(uuid())

  locadorId String
  unidadeId String
  kitnetId String
  inquilinoId String

  dataInicio DateTime
  dataFim DateTime?

  valorAluguel Float

  diaVencimento Int

  tipoGarantia String?

  valorCaucao Float?

  indiceReajuste String?

  status String @default("ATIVO")

  observacoes String?

  locador Locador @relation(fields: [locadorId], references: [id])

  unidade Unidade @relation(fields: [unidadeId], references: [id])

  kitnet Kitnet @relation(fields: [kitnetId], references: [id])

  inquilino Inquilino @relation(fields: [inquilinoId], references: [id])

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  receitas Receita[]
}

model Locador {
  id                 String    @id @default(uuid())
  nome               String
  email              String?   @unique
  telefone           String?
  cpfCnpj            String?   @unique

  endereco           String?
  cidade             String?
  uf                 String?

  banco              String?
  agencia            String?
  conta              String?

  taxaAdministracao  Float?    @default(0)
  multa              Float?    @default(0)
  juros              Float?    @default(0)

  ativo              Boolean   @default(true)

  unidades           Unidade[]

  contratos          Contrato[]

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model Receita {

  id String @id @default(uuid())

  contratoId String?

  contrato Contrato? @relation(fields: [contratoId], references: [id])

  categoria String

  descricao String

  valor Float

  vencimento DateTime?

  dataPagamento DateTime?

  status String @default("PENDENTE")

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

}

model Despesa {

  id String @id @default(uuid())

  categoria String

  descricao String

  valor Float

  vencimento DateTime?

  dataPagamento DateTime?

  status String @default("PENDENTE")

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

}