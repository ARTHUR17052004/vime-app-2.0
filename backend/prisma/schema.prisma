generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Unidade {
  id                  String     @id @default(uuid())
  nome                String
  cidade              String
  uf                  String
  locador             String?
  kitnets             Int
  status              String     @default("ATIVA")
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  aluguel             Float?
  bairro              String?
  cep                 String?
  complemento         String?
  locadorId           String?
  logradouro          String?
  numero              String?
  observacoes         String?
  vencimento          Int?
  contratos           Contrato[]
  kitnetsRelacionadas Kitnet[]
  locadorRel          Locador?   @relation(fields: [locadorId], references: [id])
  despesas            Despesa[]
  vistorias           Vistoria[]
}

model Kitnet {
  id         String      @id @default(uuid())
  numero     String
  metragem   Float
  aluguel    Float
  ocupada    Boolean     @default(false)
  status     String      @default("DISPONIVEL")
  unidadeId  String
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  nome       String?
  contratos  Contrato[]
  inquilinos Inquilino[]
  unidade    Unidade     @relation(fields: [unidadeId], references: [id], onDelete: Cascade)
  vistorias  Vistoria[]
}

model Inquilino {
  id                 String     @id @default(uuid())
  nome               String
  email              String
  telefone           String
  cpf                String
  dataInicioContrato DateTime
  ativo              Boolean    @default(true)
  kitnetId           String
  asaasCustomerId    String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  contatoEmergencia  String?
  dataFimContrato    DateTime?
  dataNascimento     DateTime?
  enderecoAnterior   String?
  indiceReajuste     String?
  prazoContrato      Int?
  rg                 String?
  telefoneEmergencia String?
  tipoGarantia       String?
  valorCaucao        Float?
  contratos          Contrato[]
  receitas           Receita[]
  kitnet             Kitnet     @relation(fields: [kitnetId], references: [id], onDelete: Cascade)
}

model Usuario {
  id String @id @default(uuid())

  nome     String
  email    String  @unique
  telefone String?

  senha String

  perfilId String?

  perfil Perfil? @relation(fields: [perfilId], references: [id])

  ativo Boolean @default(true)

  foto String?

  resetSenhaToken    String?   @unique
  resetSenhaExpiraEm DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notificacoes Notificacao[]
}

model Notificacao {
  id          String   @id @default(uuid())

  usuarioId   String?

  origem      String   // ex: "WHATSAPP", "ASAAS", "CLICKSIGN", "SISTEMA"

  titulo      String

  mensagem    String

  link        String?

  lida        Boolean  @default(false)
  lidaEm      DateTime?

  createdAt   DateTime @default(now())

  usuario     Usuario? @relation(fields: [usuarioId], references: [id])
}

model Perfil {
  id String @id @default(uuid())

  nome      String  @unique
  descricao String?

  ativo Boolean @default(true)

  permissoes Json?

  usuarios Usuario[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Contrato {
  id             String    @id @default(uuid())
  locadorId      String
  unidadeId      String
  kitnetId       String
  inquilinoId    String
  dataInicio     DateTime
  dataFim        DateTime?
  valorAluguel   Float
  diaVencimento  Int
  tipoGarantia   String?
  valorCaucao    Float?
  indiceReajuste String?
  status         String    @default("PENDENTE")
  observacoes    String?
  clicksignDocumentKey String?
  clicksignSigningUrl  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  inquilino      Inquilino @relation(fields: [inquilinoId], references: [id], onDelete: Cascade)
  kitnet         Kitnet    @relation(fields: [kitnetId], references: [id], onDelete: Cascade)
  locador        Locador   @relation(fields: [locadorId], references: [id], onDelete: Cascade)
  unidade        Unidade   @relation(fields: [unidadeId], references: [id], onDelete: Cascade)
  receitas       Receita[]
}

model Locador {
  id String @id @default(uuid())

  tipoPessoa String @default("PF")

  nome String

  cpfCnpj String? @unique

  email String? @unique

  telefone String?

  banco String?

  agencia String?

  conta String?

  pix String?

  taxaAdministracao Float? @default(0)

  multa Float? @default(0)

  juros Float? @default(0)

  endereco String?

  cidade String?

  uf String?

  observacoes String?

  ativo Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  contratos Contrato[]

  unidades Unidade[]
}

model Receita {
  id              String    @id @default(uuid())
  contratoId      String?
  inquilinoId     String?
  categoria       String
  descricao       String
  valor           Float
  vencimento      DateTime?
  dataPagamento   DateTime?
  status          String    @default("PENDENTE")
  formaPagamento  String?
  descontoValor   Float?
  descontoDias    Int?
  multaValor      Float?
  jurosValor      Float?
  asaasPaymentId  String?   @unique
  asaasCustomerId String?
  enviadaAsaas    Boolean   @default(false)
  lembreteEnviadoEm DateTime?
  fixado          Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  contrato        Contrato? @relation(fields: [contratoId], references: [id])
  inquilino       Inquilino? @relation(fields: [inquilinoId], references: [id])
}

model Despesa {
  id            String    @id @default(uuid())
  categoria     String
  descricao     String
  valor         Float
  vencimento    DateTime?
  dataPagamento DateTime?
  status        String    @default("PENDENTE")
  fixado        Boolean   @default(false)
  unidadeId     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  unidade       Unidade?  @relation(fields: [unidadeId], references: [id], onDelete: SetNull)
}

model Solicitacao {
  id String @id @default(uuid())

  numero String

  titulo String

  descricao String?

  responsavel String?

  data DateTime?

  prazo DateTime?

  status String @default("SOLICITADA")

  observacoes String?

  resposta String?

  criadoPorId String?

  criadoPorNome String?

  criadoPorPerfil String?

  mensagens SolicitacaoMensagem[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model SolicitacaoMensagem {
  id String @id @default(uuid())

  solicitacaoId String

  solicitacao Solicitacao @relation(fields: [solicitacaoId], references: [id], onDelete: Cascade)

  autorId String?

  autorNome String

  texto String?

  statusAlterado String?

  anexoNome String?

  anexoTipo String?

  anexoDados String?

  createdAt DateTime @default(now())
}

model Vistoria {
  id String @id @default(uuid())

  titulo String

  descricao String?

  unidadeId String?

  kitnetId String?

  categoria String?

  criticidade String?

  periodicidade String?

  responsavel String?

  status String @default("PENDENTE")

  data DateTime?

  dataUltima DateTime?

  dataProxima DateTime?

  concluidaEm DateTime?

  fixado Boolean @default(false)

  checklist Json?

  fotos Json?

  fotosConclusao Json?

  observacoes String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  unidade Unidade? @relation(fields: [unidadeId], references: [id], onDelete: SetNull)

  kitnet Kitnet? @relation(fields: [kitnetId], references: [id], onDelete: SetNull)

  ocorrencias Ocorrencia[]
}

model Ocorrencia {
  id String @id @default(uuid())

  vistoriaId String

  titulo String

  descricao String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  vistoria Vistoria @relation(fields: [vistoriaId], references: [id], onDelete: Cascade)
}

model LogSistema {
  id String @id @default(uuid())

  usuarioId   String?
  usuarioNome String?

  modulo String
  acao   String

  descricao String?

  ip String?

  createdAt DateTime @default(now())
}

model Auditoria {
  id String @id @default(uuid())

  usuarioId String?

  usuarioNome String?

  modulo String

  registroId String?

  acao String

  valorAnterior Json?

  valorNovo Json?

  ip String?

  createdAt DateTime @default(now())
}

model ConfiguracaoWhatsapp {
  id String @id @default(uuid())

  nomeConexao String @default("VIME 2.0")

  numero String?

  token String?

  phoneNumberId String?

  apiUrl String?

  provider String @default("META")

  conectado Boolean @default(false)

  qrCode String?

  webhook String?

  ultimaSincronizacao DateTime?

  iaAtivo Boolean @default(false)

  iaApiKey String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model WhatsappContato {
  id String @id @default(uuid())

  nome String?

  telefone String @unique

  foto String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  conversas WhatsappConversa[]
}

model WhatsappConversa {
  id String @id @default(uuid())

  contatoId String

  ultimaMensagem String?

  ultimaData DateTime?

  naoLidas Int @default(0)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  contato WhatsappContato @relation(fields: [contatoId], references: [id])

  mensagens WhatsappMensagem[]
}

model WhatsappMensagem {
  id String @id @default(uuid())

  conversaId String

  mensagemIdMeta String?

  texto String

  tipo String

  status String?

  enviadaPorIA Boolean @default(false)

  createdAt DateTime @default(now())

  conversa WhatsappConversa @relation(fields: [conversaId], references: [id])
}
model Configuracao {
  id               Int      @id @default(autoincrement())

  empresa          String
  cnpj             String?
  telefone         String?
  email            String?

  endereco         String?
  cidade           String?
  uf               String?
  cep              String?

  logo             String?
  tema             String? @default("claro")

  corPrimaria      String? @default("#F4C430")
  corSecundaria    String? @default("#1F2937")

  nomeSistema        String?
  nomeEmpresa        String?
  textoLogin         String?
  textoRodape        String?
  mensagemBoasVindas String?

  smtpHost         String?
  smtpPorta        Int?
  smtpUsuario      String?
  smtpSenha        String?

  asaasToken            String?
  asaasAmbiente         String?  @default("sandbox")
  asaasWalletId         String?
  asaasWebhookToken     String?
  asaasTaxaAdministracao Float?  @default(0)

  clicksignToken        String?
  clicksignAmbiente     String?  @default("sandbox")

  whatsappToken    String?
  whatsappNumero   String?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model ModeloDocumento {
  id String @id @default(uuid())

  tipo String @unique

  nomeArquivo String?

  conteudo String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Config de "quais campos são obrigatórios" por módulo, definida em
// Administração. Sem linha aqui = campo opcional (comportamento atual).
model CampoObrigatorio {
  id String @id @default(uuid())

  modulo String
  campo  String

  obrigatorio Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([modulo, campo])
}