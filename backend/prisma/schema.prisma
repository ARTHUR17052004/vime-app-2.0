const prisma = require("../config/prisma");

const listar = () => {
  return prisma.unidade.findMany({
    include: {
      locadorRel: true,
    },
    orderBy: {
      createdAt: "desc",
    },
  });
};

const buscarPorId = (id) => {
  return prisma.unidade.findUnique({
    where: {
      id,
    },
    include: {
      locadorRel: true,
    },
  });
};

const criar = (dados) => {
  return prisma.unidade.create({
    data: {
      nome: dados.nome,
      cep: dados.cep || null,
      logradouro: dados.logradouro || null,
      numero: dados.numero || null,
      complemento: dados.complemento || null,
      bairro: dados.bairro || null,
      cidade: dados.cidade,
      uf: dados.uf,
      locador: dados.locador || null,
      locadorId: dados.locadorId || null,
      kitnets: Number(dados.kitnets || 0),
      aluguel:
        dados.aluguel !== ""
          ? Number(dados.aluguel)
          : null,
      vencimento:
        dados.vencimento !== ""
          ? Number(dados.vencimento)
          : null,
      status: (dados.status || "ATIVA").toUpperCase(),
      observacoes: dados.observacoes || null,
    },
  });
};

const atualizar = (id, dados) => {
  return prisma.unidade.update({
    where: {
      id,
    },
    data: {
      nome: dados.nome,
      cep: dados.cep || null,
      logradouro: dados.logradouro || null,
      numero: dados.numero || null,
      complemento: dados.complemento || null,
      bairro: dados.bairro || null,
      cidade: dados.cidade,
      uf: dados.uf,
      locador: dados.locador || null,
      locadorId: dados.locadorId || null,
      kitnets: Number(dados.kitnets || 0),
      aluguel:
        dados.aluguel !== ""
          ? Number(dados.aluguel)
          : null,
      vencimento:
        dados.vencimento !== ""
          ? Number(dados.vencimento)
          : null,
      status: (dados.status || "ATIVA").toUpperCase(),
      observacoes: dados.observacoes || null,
    },
  });
};

const remover = (id) => {
  return prisma.unidade.delete({
    where: {
      id,
    },
  });
};

module.exports = {
  listar,
  buscarPorId,
  criar,
  atualizar,
  remover,
};